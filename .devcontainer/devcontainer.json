{
  "name": "PanelGuard",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "sh tools/takehome/setup.sh",
  "forwardPorts": [
    7860
  ],
  "portsAttributes": {
    "7860": {
      "label": "PanelGuard operator console",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
